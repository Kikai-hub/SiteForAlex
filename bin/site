#!/usr/bin/env bash
# Adana Pizza — one-word console commands for running the site under Docker.
#
# Usage from the repo root:      ./bin/site <command>
# Or, after `sudo ln -s "$(pwd)/bin/site" /usr/local/bin/site` (see
# DEPLOY.md), from anywhere:     site <command>
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"

compose() {
  docker compose "$@"
}

usage() {
  cat <<'EOF'
Usage: site <command>

  start     Start the site (builds images on first run)
  stop      Stop and remove the site's containers (data is kept)
  restart   Restart the running containers in place
  status    Show container status
  logs      Follow logs (optionally: site logs web|migrate|caddy)
  deploy    Pull the latest commit from GitHub, rebuild, migrate, restart
  seed      Run the one-time database seed (creates the admin account)
  backup    Dump the database + uploaded media to ./backups/
EOF
}

cmd="${1:-}"
shift || true

case "$cmd" in
  start)
    compose up -d
    echo "Site is up. Check with: site status"
    ;;
  stop)
    compose down
    ;;
  restart)
    compose restart
    ;;
  status)
    compose ps
    ;;
  logs)
    if [ "${1:-}" != "" ]; then
      compose logs -f --tail=200 "$1"
    else
      compose logs -f --tail=200
    fi
    ;;
  deploy)
    echo "==> Fetching latest commit from GitHub..."
    git fetch origin
    git reset --hard "origin/$(git rev-parse --abbrev-ref HEAD)"
    echo "==> Rebuilding and restarting (migrations run automatically)..."
    compose up -d --build
    docker image prune -f >/dev/null 2>&1 || true
    echo "==> Deployed $(git rev-parse --short HEAD)."
    ;;
  seed)
    compose run --rm migrate npx prisma db seed
    ;;
  backup)
    mkdir -p backups
    stamp="$(date +%Y%m%d-%H%M%S)"
    echo "==> Backing up database..."
    docker run --rm -v adana-pizza_db_data:/data -v "$REPO_DIR/backups:/backup" \
      alpine tar czf "/backup/db-$stamp.tar.gz" -C /data .
    echo "==> Backing up uploaded media..."
    docker run --rm -v adana-pizza_uploads_data:/data -v "$REPO_DIR/backups:/backup" \
      alpine tar czf "/backup/uploads-$stamp.tar.gz" -C /data .
    echo "==> Wrote backups/db-$stamp.tar.gz and backups/uploads-$stamp.tar.gz"
    ;;
  ""|help|-h|--help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
