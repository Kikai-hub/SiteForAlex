generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  PHOTO
  VIDEO
}

enum PromoType {
  PERCENT
  FIXED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  WAITING_FOR_CAPTURE
  SUCCEEDED
  CANCELED
  REFUNDED
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model Courier {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  orders Order[]
}

model Customer {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  addresses    Address[]
  orders       Order[]
  comments     Comment[]
}

/** Bonus-points balance, keyed by phone number rather than Customer — points
 *  accrue for a phone from its very first order, whether or not that phone
 *  has registered an account yet. Once someone registers with that phone
 *  (Customer.phone is unique, same normalized format — see lib/phone.ts),
 *  looking their wallet up by phone just finds it; no migration/merge step
 *  is needed. */
model BonusWallet {
  id        String   @id @default(cuid())
  phone     String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BonusTransaction[]
}

enum BonusTransactionType {
  /** Awarded when an order reaches DELIVERED (see Order.bonusEarnedAt). */
  EARN
  /** Spent as a discount on an order at checkout. */
  REDEEM
  /** A REDEEM reversed because its order was cancelled after the discount was applied. */
  REFUND
  /** Manual balance change made by an admin (goodwill credit, correction, etc). */
  ADJUSTMENT
}

model BonusTransaction {
  id        String               @id @default(cuid())
  walletId  String
  wallet    BonusWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      BonusTransactionType
  /** Positive for EARN/REFUND/positive ADJUSTMENT, negative for REDEEM/negative ADJUSTMENT. */
  amount    Int
  orderId   Int?
  order     Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note      String?
  createdAt DateTime             @default(now())

  @@index([walletId])
  @@index([orderId])
}

/** Single-row table holding the bonus program's admin-configurable rules — a
 *  BonusSettings row is looked up/created by the fixed id "singleton" rather
 *  than through a separate feature-flag/config system this project doesn't
 *  otherwise have. */
model BonusSettings {
  id                String   @id @default("singleton")
  /** % of an order's paid total (see Order.bonusPointsEarned) credited as points once it's DELIVERED. */
  earnPercent       Int      @default(5)
  /** Max % of an order's subtotal that bonus points are allowed to discount. */
  maxRedeemPercent  Int      @default(50)
  updatedAt         DateTime @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  city       String   @default("Москва")
  street     String
  house      String
  apartment  String?
  entrance   String?
  floor      String?
  comment    String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  dishes    Dish[]
}

model Dish {
  id              String   @id @default(cuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  caloriesPer100g Int?
  proteinPer100g  Float?
  fatPer100g      Float?
  carbsPer100g    Float?
  isActive        Boolean  @default(true)
  /** Whether bonus points can be redeemed as a discount against this dish
   *  (see BonusSettings) — the admin can turn this off per dish (e.g. items
   *  already running at a promo margin). Defaults on since most dishes are
   *  expected to allow it. */
  bonusRedeemable Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  variants   DishVariant[]
  media      MediaAsset[]
  extras     DishExtra[]
  comments   Comment[]
  heroSlides HeroSlide[]
}

/** A slide in the homepage hero carousel (promos, sets, featured dishes — the
 *  "big pizza" banner block). Optionally linked to a Dish so its CTA can point
 *  at that dish's page; imageUrl/title/description are always editable
 *  independently so a slide can also be a pure marketing banner with no dish. */
model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String?
  imageUrl    String?
  badgeText   String?
  priceLabel  String?
  ctaLabel    String   @default("Подробнее")
  ctaHref     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dishId String?
  dish   Dish?   @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@index([dishId])
  @@index([isActive, sortOrder])
}

model DishVariant {
  id          String   @id @default(cuid())
  dishId      String
  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  label       String
  priceMinor  Int
  weightGrams Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  orderItems OrderItem[]
}

/** Extra portions of an ingredient a customer can add to this dish (e.g. "double cheese").
 *  Scoped per-dish because ingredients differ between dishes; the admin curates the list. */
model DishExtra {
  id          String   @id @default(cuid())
  dishId      String
  dish        Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  name        String
  priceMinor  Int
  maxQuantity Int      @default(5)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  /** Shown inline on the dish page (like the size picker) instead of tucked into the "Дополнительно" modal. */
  featured    Boolean  @default(false)

  orderItemExtras OrderItemExtra[]
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

/** A review left by a registered customer under a dish: an optional text body plus a
 *  required 1-5 star rating. Held as PENDING until an admin approves it for public display. */
model Comment {
  id           String        @id @default(cuid())
  dishId       String
  dish         Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body         String?
  rating       Int
  status       CommentStatus @default(PENDING)
  adminReply   String?
  adminReplyAt DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([dishId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  dishId    String
  dish      Dish      @relation(fields: [dishId], references: [id], onDelete: Cascade)
  type      MediaType
  url       String
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
}

model PromoCode {
  id                  String    @id @default(cuid())
  code                String    @unique
  type                PromoType
  value               Int
  minOrderAmountMinor Int?
  maxUsesTotal        Int?
  maxUsesPerCustomer  Int?
  usedCount           Int       @default(0)
  startsAt            DateTime?
  expiresAt           DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  orders Order[]
}

model Order {
  id Int @id @default(autoincrement())

  /** Unguessable lookup key for the public order-confirmation page — Order.id is
   *  sequential and must never be used to authorize access to another customer's order. */
  accessToken String @unique @default(cuid())

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  guestName  String
  guestPhone String

  fulfillmentType FulfillmentType

  addressCity      String?
  addressStreet    String?
  addressHouse     String?
  addressApartment String?
  addressEntrance  String?
  addressFloor     String?
  addressComment   String?

  paymentMethod PaymentMethod
  status        OrderStatus   @default(NEW)

  /** Only meaningful when paymentMethod is ONLINE — CASH/CARD orders are paid
   *  on delivery/pickup and never go through YooKassa. */
  paymentStatus     PaymentStatus @default(PENDING)
  yookassaPaymentId String?       @unique
  paidAt            DateTime?

  /** Unassigned until a courier claims it from the "new orders" pool. */
  courierId   String?
  courier     Courier?  @relation(fields: [courierId], references: [id], onDelete: SetNull)
  assignedAt  DateTime?
  deliveredAt DateTime?

  subtotalMinor Int
  discountMinor Int @default(0)
  totalMinor    Int

  promoCodeId       String?
  promoCode         PromoCode? @relation(fields: [promoCodeId], references: [id])
  promoCodeSnapshot String?

  /** Points redeemed as a discount on this order (see bonusDiscountMinor) —
   *  0 if none were used. Refunded back to the wallet if the order is later
   *  CANCELLED (see BonusTransactionType.REFUND). */
  bonusPointsRedeemed Int       @default(0)
  bonusDiscountMinor  Int       @default(0)
  /** Points credited to the customer's/guest's wallet for this order — 0
   *  until it happens. Only ever set once, when status transitions to
   *  DELIVERED (see lib/bonus.ts) — bonusEarnedAt guards against crediting
   *  twice if the status is (re)set to DELIVERED again. */
  bonusPointsEarned   Int       @default(0)
  bonusEarnedAt       DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items             OrderItem[]
  bonusTransactions BonusTransaction[]
}

model OrderItem {
  id      String @id @default(cuid())
  orderId Int
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId        String?
  dishVariantId String?
  dishVariant   DishVariant? @relation(fields: [dishVariantId], references: [id])

  nameSnapshot         String
  variantLabelSnapshot String
  unitPriceMinor       Int
  quantity             Int
  lineTotalMinor       Int

  extras OrderItemExtra[]
}

/** Snapshot of an extra chosen for one order line. quantity is per single unit of the
 *  dish (e.g. 2 = "double cheese"); the actual charge is unitPriceMinor * quantity *
 *  OrderItem.quantity, mirroring how OrderItem.unitPriceMinor relates to lineTotalMinor. */
model OrderItemExtra {
  id          String     @id @default(cuid())
  orderItemId String
  orderItem   OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  dishExtraId String?
  dishExtra   DishExtra? @relation(fields: [dishExtraId], references: [id], onDelete: SetNull)

  nameSnapshot   String
  unitPriceMinor Int
  quantity       Int
}
