# Copy to .env and fill in. install.sh does this automatically on a fresh
# server install (and generates SESSION_SECRET for you).

# --- Database (Postgres) ---
# Local `npm run dev` / `npm run db:migrate` reads this directly. Inside
# Docker Compose, docker-compose.yml builds DATABASE_URL itself from
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB below — set those, not this.
DATABASE_URL="postgresql://adana:adana@localhost:5432/adana_pizza"
POSTGRES_USER="adana"
POSTGRES_PASSWORD="adana"
POSTGRES_DB="adana_pizza"

# --- Cache / rate limiting (Redis) ---
# Shared across all PM2 cluster workers — see cache-handler.js and lib/rateLimit.ts.
REDIS_URL="redis://localhost:6379"

# --- Sessions ---
# Required in production — generate a real random value, e.g.: openssl rand -base64 48
SESSION_SECRET="dev-only-insecure-secret-change-me"

# --- Admin account (prisma/seed.ts) ---
# Required in production — the seed script refuses to create the well-known
# dev admin credentials outside development.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD=""

# --- Reverse proxy trust (proxy.ts) ---
# 0 = no trusted proxy in front of the app (direct exposure, e.g. `npm run dev`).
# docker-compose.yml overrides this to 1 for the Caddy setup.
TRUSTED_PROXY_HOPS=0

# --- Optional: HTTPS domain (Caddy auto-provisions Let's Encrypt once set) ---
# SITE_DOMAIN="yourdomain.ru"

# --- Optional: delivery address autocomplete (Yandex Geosuggest) ---
# YANDEX_MAPS_API_KEY=""

# --- Optional: online card payment (YooKassa) — omit to offer cash/card-on-delivery only ---
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""
